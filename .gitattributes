# Shell scripts must stay LF on every platform: Linux/WSL bash rejects CRLF,
# and release archives are built from the working tree.
* text=auto
*.sh text eol=lf
bin/wgdi text eol=lf
*.md text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.tsv text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.zip binary
*.gz binary
